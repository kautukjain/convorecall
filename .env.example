# Copy to .env and fill in. Never commit real secrets.
# Every key here is validated at startup by apps/api/src/config/env.ts.
# Defaults of record: docs/Harness.md and docs/Jobs.md.

# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database — required from Phase 1. Matches infra/compose/docker-compose.yml.
DATABASE_URL=postgresql://opengong:opengong@localhost:5433/opengong?schema=public

# Model provider (ADR-003) — required from Phase 2.
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1
PYAI_STT_MODEL=pyai-hear
PYAI_LLM_MODEL=gpt-4o-mini

# Harness — docs/Harness.md
JOB_DEADLINE_MS=900000
JOB_TOKEN_BUDGET=120000
LLM_REQUEST_TIMEOUT_MS=30000
# Per-channel speaker separation. true = each party is on its own channel (most dialers, and the
# bundled two-party sample audio) and PyAI reads turns off the recording exactly. false = mono
# diarization, which infers turns and can over-split one voice into several. Ignored for mono files.
STT_CHANNEL_DIARIZATION=false

STT_REQUEST_TIMEOUT_MS=600000
TRANSPORT_RETRY_MAX=3
SCHEMA_REPAIR_MAX=1
EVIDENCE_MATCH_THRESHOLD=0.85

# Worker — docs/Jobs.md. WORKER_ENABLED=false is the split-out seam.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_MS=10000
WORKER_STALE_AFTER_MS=60000
JOB_MAX_ATTEMPTS=3

# Uploads — docs/API.md
UPLOAD_MAX_BYTES=12582912
UPLOAD_MAX_DURATION_MS=7200000

# Optional: object storage for uploads (Phase 1+)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Extraction LLM toggle. false = PyAI only (Hear + Recap), the one-API path. true = PyAI plus the
# model below, which then supplies next steps, intent, and the follow-up email — the sections
# Recap does not evidence. Requires LLM_BASE_URL and LLM_API_KEY when true.
LLM_ENABLED=false

# Extraction LLM (ADR-003) — separate from PyAI, which serves speech only.
# Optional for the five sample calls: with no key they replay a recorded extraction through
# the real evidence gate (ADR-016). Required to analyse your own audio, and to `pnpm record`.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional second endpoint, tried only if the one above fails (transport errors, rate limits,
# or an exhausted balance). Leave blank for a single provider. Order is config, not code:
# PyAI cannot go here today — it serves speech, and /v1/chat/completions is 404 unknown_route.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
